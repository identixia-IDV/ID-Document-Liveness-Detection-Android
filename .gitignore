!gradle/wrapper/gradle-wrapper.jar
libdocumentlivenesssdk/**/*.aar
libdocumentlivenesssdk/**/*.so
libdocumentlivenesssdk/**/*.xdb
libdocumentlivenesssdk/**/jniLibs/
!libdocumentlivenesssdk/**/jniLibs/.gitkeep
!libdocumentlivenesssdk/**/jniLibs/**/.gitkeep
!libdocumentlivenesssdk/README.md
!libdocumentlivenesssdk/build.gradle


